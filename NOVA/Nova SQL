--Question4.1
with CustomerOrders as (
    select CustomerID,
    Count(distinct OrderID) as Number_of_Orders
    from Sales 
    group by CustomerID 
),
CustomerGroups as (
    select CustomerID,
    case
    when Rating in(4,5) then 'Highly Satisfied'
    when Rating in (1,2,3) then 'Less Satisfied'
    end as SatisfactionGroup
    from Customer_Feedback
)
select cg.SatisfactionGroup,
round(avg(co.Number_of_Orders),2) as Average_Number_of_Orders,
count(distinct cg.CustomerID) AS TotalCustomers
from CustomerGroups cg
inner join CustomerOrders co
on cg.CustomerID=co.CustomerID
group by cg.SatisfactionGroup
order by Average_Number_of_Orders DESC;

--Question4.2
select 
case
when DiscountPercent =0 then '0%'
when DiscountPercent >0 and DiscountPercent <=10 then '1-10%'
when DiscountPercent >10 and DiscountPercent <=20 then '11-20%'
when DiscountPercent >20 and DiscountPercent<=30 then '21-30%'
end Discount_Band,
Round(sum(TotalSales),2)as TotalSales,
Round(sum(Profit),2)as TotalProfit,
Round ((sum(Profit)/sum(TotalSales))*100,2) as ProfitMargin
from Sales
Where DiscountPercent <=30
group by 
case 
when DiscountPercent = 0 then '0%'
when DiscountPercent >0 and DiscountPercent <=10 then '1-10%'
when DiscountPercent>10 and DiscountPercent <=20 then '11-20%'
when DiscountPercent>20 and DiscountPercent <=30 then '21-30%'
end
order by Discount_Band;

--Question4.3
With ProductPerformance as(
    select
    p.ProductName,
    p.Category,
    Sum(s.TotalSales) as Total_Revenue,
    Sum(s.Quantity) as Sales_Volume,
    Sum(s.Profit) as Total_Profit
    From Sales s
    join Products p on s.ProductID = p.ProductID
    Group by p.ProductName, p.Category
),
RankedProducts as (
    select ProductName,
    Category,
    Total_Revenue,
    Sales_Volume,
    Round((Total_Profit/Total_Revenue)*100,2) as ProfitMargin,
    ROW_NUMBER() Over(
        Order by Total_Revenue ASC) as RevenueBank
        from ProductPerformance)
Select ProductName,
Category,
Round(Total_Revenue,2) as Total_Revenue,
Sales_Volume,
ProfitMargin
from RankedProducts
where RevenueBank<=5 
Order by Total_Revenue ASC;

