with ProductPerformance as (
    select p.ProductName,
    p.Category,
    Sum(s.TotalSales)as Total_Revenue,
    Sum(s.Quantity) as Sales_Volume,
    Sum(s.Profit) as TotalProfit,
    AVG(cf.Rating) as Average_Rating
from Sales s
join Products p
on p.ProductID=s.ProductID
left join Customer_Feedback cf
on s.OrderID=cf.OrderID
group by p.ProductName,
p.Category
),
RankedProducts as (
    select ProductName,
    Category,
    Total_Revenue,
    Sales_Volume,
    round((TotalProfit/Total_Revenue)*100,2) as ProfitMargin,
    Round(Average_Rating,2) as AverageRating,
    ROW_NUMBER()Over(Order by Total_Revenue ASC) As RevenueBank
    From ProductPerformance
)
select ProductName,
Category,
round(Total_Revenue,2) as TotalRevenue,
Sales_Volume,
ProfitMargin,
AverageRating
from RankedProducts
where RevenueBank <=5
order by TotalRevenue ASC;
